"},"layoutSizingHorizontal":"FIXED","layoutSizingVertical":"HUG","effects":[],"interactions":[]},{"id":"I4122:29773;22501:122091","name":"Frame 8430","type":"FRAME","scrollBehavior":"SCROLLS","children":[{"id":"I4122:29773;22501:122092","name":"i Kostenlos inserieren können private Anbieter, die in den letzten 24 Monaten keine Objekte auf immowelt.de inseriert haben. Dies gilt deutschlandweit für alle Immobilien, die zur Miete auf immowelt.de mit einem 14-Tage-Einsteigerpaket eingestellt werden. Die Anzeige mit der Mindestlaufzeit von 14 Tagen lässt sich jederzeit bis zu einem Tag vor Ablauf kündigen. Anschließend verlängert sich die Anzeige automatisch auf unbestimmte Zeit zum regulären Anzeigenpreis. Sie kann dann jederzeit mit einer Kündigungsfrist von einem Tag zum Ende eines Zyklus von jeweils zwei Wochen, der mit der automatischen Verlängerung beginnt, gekündigt werden. Es gelten die aktuell allgemein gültigigen Preise.","type":"TEXT","scrollBehavior":"SCROLLS","boundVariables":{"fills":[{"type":"VARIABLE_ALIAS","id":"VariableID:56933349878d7652e2f3c50d584145de31eabd57/39790:1186"}]},"blendMode":"PASS_THROUGH","fills":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.19607843458652496,"g":0.19607843458652496,"b":0.19607843458652496,"a":1.0},"boundVariables":{"color":{"type":"VARIABLE_ALIAS","id":"VariableID:56933349878d7652e2f3c50d584145de31eabd57/39790:1186"}}}],"strokes":[],"strokeWeight":1.0,"strokeAlign":"OUTSIDE","styles":{"fill":"2658:5355","text":"1567:21438"},"absoluteBoundingBox":{"x":334.0,"y":6386.0,"width":328.0,"height":208.0},"absoluteRenderBounds":null,"constraints":{"vertical":"TOP","horizontal":"LEFT"},"layoutAlign":"INHERIT","layoutGrow":1.0,"layoutSizingHorizontal":"FILL","layoutSizingVertical":"HUG","characters":"i Kostenlos inserieren können private Anbieter, die in den letzten 24 Monaten keine Objekte auf immowelt.de inseriert haben. Dies gilt deutschlandweit für alle Immobilien, die zur Miete auf immowelt.de mit einem 14-Tage-Einsteigerpaket eingestellt werden. Die Anzeige mit der Mindestlaufzeit von 14 Tagen lässt sich jederzeit bis zu einem Tag vor Ablauf kündigen. Anschließend verlängert sich die Anzeige automatisch auf unbestimmte Zeit zum regulären Anzeigenpreis. Sie kann dann jederzeit mit einer Kündigungsfrist von einem Tag zum Ende eines Zyklus von jeweils zwei Wochen, der mit der automatischen Verlängerung beginnt, gekündigt werden. Es gelten die aktuell allgemein gültigigen Preise.","characterStyleOverrides":[],"styleOverrideTable":{},"lineTypes":["NONE"],"lineIndentations":[0],"style":{"fontFamily":"Inter","fontPostScriptName":null,"fontStyle":"Regular","fontWeight":400,"textAutoResize":"HEIGHT","fontSize":12.0,"textAlignHorizontal":"JUSTIFIED","textAlignVertical":"TOP","letterSpacing":0.0,"lineHeightPx":16.0,"lineHeightPercent":110.1721420288086,"lineHeightPercentFontSize":133.3333282470703,"lineHeightUnit":"PIXELS"},"layoutVersion":4,"effects":[],"interactions":[]}],"blendMode":"PASS_THROUGH","clipsContent":false,"background":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.9764705896377563,"g":0.9764705896377563,"b":0.9764705896377563,"a":1.0}}],"fills":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.9764705896377563,"g":0.9764705896377563,"b":0.9764705896377563,"a":1.0}}],"strokes":[],"strokeWeight":1.0,"strokeAlign":"INSIDE","backgroundColor":{"r":0.9764705896377563,"g":0.9764705896377563,"b":0.9764705896377563,"a":1.0},"styles":{"fills":"2694:15230","fill":"2694:15230"},"layoutMode":"HORIZONTAL","primaryAxisSizingMode":"FIXED","counterAxisAlignItems":"CENTER","primaryAxisAlignItems":"CENTER","paddingLeft":16.0,"paddingRight":16.0,"paddingTop":64.0,"paddingBottom":64.0,"itemSpacing":10.0,"layoutWrap":"NO_WRAP","absoluteBoundingBox":{"x":318.0,"y":6322.0,"width":360.0,"height":336.0},"absoluteRenderBounds":null,"constraints":{"vertical":"TOP","horizontal":"LEFT"},"layoutSizingHorizontal":"FIXED","layoutSizingVertical":"HUG","effects":[],"interactions":[]}],"blendMode":"PA