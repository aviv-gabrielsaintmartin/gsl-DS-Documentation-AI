,"primaryAxisAlignItems":"CENTER","paddingTop":80.0,"layoutWrap":"NO_WRAP","absoluteBoundingBox":{"x":19709.0,"y":3762.0,"width":328.0,"height":188.0},"absoluteRenderBounds":null,"constraints":{"vertical":"TOP","horizontal":"LEFT"},"layoutAlign":"STRETCH","layoutGrow":0.0,"layoutSizingHorizontal":"FILL","layoutSizingVertical":"HUG","effects":[],"interactions":[]},{"id":"4041:8902","name":"Article/Paragraph (Variants)","type":"INSTANCE","scrollBehavior":"SCROLLS","componentId":"4040:42567","componentProperties":{"Property 1":{"value":"Paragraph Desktop","type":"VARIANT","boundVariables":{}}},"overrides":[{"id":"4041:8902","overriddenFields":["height","width"]},{"id":"I4041:8902;54:49168","overriddenFields":["characterStyleOverrides","characters","lineIndentations","lineTypes","styleOverrideTable"]}],"children":[{"id":"I4041:8902;54:49168","name":"Value","type":"TEXT","scrollBehavior":"SCROLLS","boundVariables":{"fills":[{"type":"VARIABLE_ALIAS","id":"VariableID:56933349878d7652e2f3c50d584145de31eabd57/39790:1186"}],"lineHeight":[{"type":"VARIABLE_ALIAS","id":"VariableID:97be071b4060292eeaf97fe4c225c58f5e868b45/51630:112"}],"letterSpacing":[{"type":"VARIABLE_ALIAS","id":"VariableID:08a533d84391627b2a71ae9ecee194180e4a8139/51630:101"}],"fontFamily":[{"type":"VARIABLE_ALIAS","id":"VariableID:7d719c4d5d29be3cc6d520c8253c65d096363193/51624:13"}],"fontSize":[{"type":"VARIABLE_ALIAS","id":"VariableID:93be8079f05e019bec0a3a14d471bba8c8f28530/51629:150"}],"fontStyle":[{"type":"VARIABLE_ALIAS","id":"VariableID:3147c40a85fcca7d2ee92b2b4e980571295e961d/51629:62"}],"paragraphSpacing":[{"type":"VARIABLE_ALIAS","id":"VariableID:19e9ccf8e314581ecaa6642535f983236931b650/51630:123"}]},"blendMode":"PASS_THROUGH","fills":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.19607843458652496,"g":0.19607843458652496,"b":0.19607843458652496,"a":1.0},"boundVariables":{"color":{"type":"VARIABLE_ALIAS","id":"VariableID:56933349878d7652e2f3c50d584145de31eabd57/39790:1186"}}}],"strokes":[],"strokeWeight":1.0,"strokeAlign":"OUTSIDE","styles":{"fill":"2658:5355","text":"3318:9165"},"absoluteBoundingBox":{"x":19709.0,"y":3966.0,"width":328.0,"height":720.0},"absoluteRenderBounds":null,"constraints":{"vertical":"TOP","horizontal":"LEFT"},"layoutAlign":"INHERIT","layoutGrow":1.0,"layoutSizingHorizontal":"FILL","layoutSizingVertical":"HUG","characters":"In contrast to a newspaper ad, you have many advantages when you advertise your apartment online. A newspaper ad only has a few lines of space, and more information than \"4 rooms in Nuremberg, 60 sqm, €700 cold\" is hardly possible. With an apartment ad on immowelt.de, you can put your apartment in the ideal light for potential tenants and buyers with pictures, videos, a floor plan and a meaningful description. You only pay for your apartment ad when you publish your ad. You can freely choose whether you want to pay by direct debit, credit card, PayPal, instant transfer or invoice. The price varies depending on whether you want to sell or rent your apartment and also depends on the term of your ad. You can determine this yourself. If you have not found a tenant or buyer at the end of this period, the term is automatically extended. Another decisive advantage is the wide reach of an apartment ad on immowelt.de. It appeals to tenants and buyers from all over Germany. You receive inquiries from interested parties conveniently by email or optionally by telephone. With an advertisement in a daily newspaper, however, you often only reach regional interested parties.","characterStyleOverrides":[],"styleOverrideTable":{},"lineTypes":["NONE"],"lineIndentations":[0],"style":{"fontFamily":"Inter","fontPostScriptName":null,"fontStyle":"Regular","fontWeight":400,"textAutoResize":"HEIGHT","fontSize":16.0,"textAlignHorizontal":"LEFT","textAlignVertical":"TOP","letterSpacing":0.0,"lineHeightPx":24.0,"lineHeightPercent":123.94366455078125,"lineHeightPercentFontSize":150.0,"lineHeightUnit":"PIXELS"},"layoutVersion":4,"effects":[