onstraints":{"vertical":"TOP","horizontal":"LEFT"},"layoutAlign":"STRETCH","layoutGrow":1.0,"layoutSizingHorizontal":"FILL","layoutSizingVertical":"FILL","characters":"We have a bright 3-room new-build flat for rent. The living room, the balcony, the kitchen, the bathroom with bathtub and daylight and the study are south-facing and therefore very bright all day long. The other two bedrooms face the quiet inner courtyard (north). There is also a spacious storage room in the flat.  The building offers a building ensemble in the popular Nordic Quarter with a total of 99 apartments, spread over three six-story buildings with an additional penthouse floor. Half of the apartments are barrier-free. A total of 44 parking spaces are available for tenants in the building's own underground car park, 20 of which are in a separate underground car park on the neighboring property. ","characterStyleOverrides":[],"styleOverrideTable":{},"lineTypes":["NONE"],"lineIndentations":[0],"style":{"fontFamily":"Inter","fontPostScriptName":null,"fontStyle":"Regular","fontWeight":400,"textAutoResize":"TRUNCATE","textTruncation":"ENDING","fontSize":16.0,"textAlignHorizontal":"LEFT","textAlignVertical":"TOP","letterSpacing":0.0,"lineHeightPx":24.0,"lineHeightPercent":123.94366455078125,"lineHeightPercentFontSize":150.0,"lineHeightUnit":"PIXELS"},"layoutVersion":4,"styles":{"text":"4900:19455"},"effects":[],"interactions":[]},{"id":"I4273:24150;1311:5568;1409:10209","name":"Gradient","visible":false,"type":"RECTANGLE","scrollBehavior":"SCROLLS","blendMode":"PASS_THROUGH","fills":[{"blendMode":"NORMAL","type":"GRADIENT_LINEAR","gradientHandlePositions":[{"x":0.6187500394011555,"y":0.04687499922463964},{"x":0.6187500394011554,"y":0.916666633489043},{"x":0.6013542052728865,"y":0.04687499906424395}],"gradientStops":[{"color":{"r":1.0,"g":1.0,"b":1.0,"a":0.0},"position":0.0},{"color":{"r":1.0,"g":1.0,"b":1.0,"a":1.0},"position":1.0}]}],"strokes":[],"strokeWeight":1.0,"strokeAlign":"INSIDE","absoluteB